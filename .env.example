# Copiar a .env y ajustar. (Ojo: la versión "vulnerable" del proyecto no lee
# un .env — las credenciales están escritas en src/config.ts. Eso es justamente
# una de las falhas que hay que corregir.)

NODE_ENV=development
PORT=3000

# Puerto publicado en el host (docker-compose.yml)
APP_PORT=8080

DB_HOST=db
DB_PORT=5432
DB_NAME=origen
DB_USER=origen_app
DB_PASSWORD=origen_app_2024

UPLOADS_DIR=/app/uploads

# Claves de las cuentas de ejemplo. No hay claves de fábrica: elegí una para
# cada cuenta que vayas a usar. Las que queden vacías se generan al azar la
# primera vez y se muestran en `docker compose logs app`.
CLAVE_ADMIN=
CLAVE_VALENTINA=
CLAVE_BARISTA=
CLAVE_MOZO=
CLAVE_CLIENTE=
