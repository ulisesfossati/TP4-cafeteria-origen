# Copiar a .env y completar:   cp .env.example .env
# El .env NO se sube al repositorio (está en .gitignore): cada uno pone sus claves.
# docker-compose.yml lo lee solo y le pasa a cada contenedor lo que necesita.

# Puerto publicado en el host (si el 8080 está ocupado, poné 8090)
APP_PORT=8080

# Contraseña del superusuario de PostgreSQL (sólo para administrar la base;
# la app nunca la usa). Obligatoria: cualquier texto largo.
POSTGRES_PASSWORD=

# Contraseña del usuario de la app, origen_app (permisos reducidos). Obligatoria.
DB_PASSWORD=

# Firma del token anti-CSRF. Si queda vacía se genera una al azar en cada arranque.
SESSION_SECRET=

# Claves de las cuentas de ejemplo. No hay claves de fábrica: elegí una para
# cada cuenta que vayas a usar. Las que queden vacías se generan al azar la
# primera vez y se muestran en `docker compose logs app`.
CLAVE_ADMIN=
CLAVE_VALENTINA=
CLAVE_BARISTA=
CLAVE_MOZO=
CLAVE_CLIENTE=
